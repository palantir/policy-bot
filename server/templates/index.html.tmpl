{{/* templatetree:extends page.html.tmpl */}}
{{define "body-class"}}pb-home{{end}}
{{define "body"}}
{{ $appsPath := "github-apps" }}
{{ if eq .GitHubURL "https://github.com" }}
  {{ $appsPath = "apps" }}
{{ end }}
{{ $appURL := printf "%s/%s/%s" .GitHubURL $appsPath .AppName }}
{{ $docsURL := printf "https://github.com/palantir/policy-bot/blob/v%s/README.md" .Version }}

<header class="pb-home-hero">
  <div class="pb-home-hero-inner">
    <div class="logo pb-home-logo"></div>
    <h1 class="pb-home-title">Policy<span>Bot</span></h1>
    <p class="pb-home-tagline">Enforce approval and disapproval policies on pull requests</p>
    <div class="pb-home-actions">
      <a class="pb-btn pb-btn-primary" href="{{$appURL}}">Install on GitHub</a>
      <a class="pb-btn pb-btn-ghost" href="{{$docsURL}}">Read the docs</a>
    </div>
    <p class="pb-home-version">v{{.Version}}</p>
  </div>
</header>

<main class="pb-home-main">
  <section class="pb-panel">
    <h2 class="pb-panel-title"><span class="pb-step-num">→</span> Getting Started</h2>
    <ol class="pb-steps">
      <li><a href="{{$appURL}}">Install <code>{{.AppName}}</code></a> on your repository</li>
      <li>Add a <code>{{.PolicyPath}}</code> file on the default branch (<a href="{{$docsURL}}#configuration">docs</a>):
        <pre class="pb-code">policy:
  approval:
    - one approval from palantir

approval_rules:
  - name: one approval from palantir
    requires:
      count: 1
      organizations: ["palantir"]</pre>
      </li>
      <li>Open a pull request and watch the status change based on the policy!</li>
    </ol>
  </section>

  <section class="pb-panel">
    <h2 class="pb-panel-title">Learn More</h2>
    <ul class="pb-links">
      <li><a href="{{$docsURL}}">Documentation</a></li>
      <li><a href="https://github.com/palantir/policy-bot">GitHub repository</a></li>
    </ul>
  </section>
</main>
{{end}}
